##fileformat=VCFv4.2
##source=panvar call
##reference=ref#0#chr1:0-4600
##contig=<ID=chr1>
##INFO=<ID=END,Number=1,Type=Integer,Description="Last reference base the variant spans, inclusive. POS is the base BEFORE the event (symbolic convention), so the event occupies POS+1..END and END-POS is its reference span: |SVLEN| for DEL/INV, 0 for INS (which spans no reference), the replaced bases for a SUBSTITUTION (whose SVLEN is the net change), and the module's own reference span for a CN_SCOPE=COLLAPSED_MODULE CNV -- there it equals INFO/CN_MODULE_REF_BP, the bubble interior (FORMAT:CNBP is measured over each haplotype's copies within it)">
##INFO=<ID=SVTYPE,Number=1,Type=String,Description="Structural variant type">
##INFO=<ID=SVLEN,Number=A,Type=Integer,Description="ALT-REF length difference for DEL/INS (negative for a deletion). A DEL/INS/INV record merged across haplotypes reports POS, END, SVLEN and its sequence from one representative member: the exact event carried by the most haplotypes (ties: the larger). Members' sizes are in SVLEN_RANGE; the record is kept by --min-sv-bp on its largest member, so a representative can be smaller than that. For INV, the length of the inverted segment, which changes no length; for CNV see CN_SCOPE. Absent on CN_SCOPE=COLLAPSED_MODULE records, and on a CN_METHOD=UNIT record whose carriers both gain and lose copies: no single record-level size exists there -- read SVLEN_RANGE, or FORMAT:CN and CNBP for the per-sample size. A UNIT record whose carriers all change in one direction gives its largest change">
##INFO=<ID=SVLEN_RANGE,Number=2,Type=Integer,Description="Min,max event size among merged members (when they differ). On a CN_METHOD=UNIT CNV: the smallest and largest carrier change, (CN-REF_CN)*RU_LEN in bp">
##INFO=<ID=BUBBLE_ID,Number=1,Type=Integer,Description="panvar bubble identifier">
##INFO=<ID=START_NODE,Number=1,Type=String,Description="First graph node of the event (of the representative member on a merged record; see SVLEN)">
##INFO=<ID=END_NODE,Number=1,Type=String,Description="Last graph node of the event">
##INFO=<ID=EVENT_NODES,Number=.,Type=String,Description="Variant node set">
##INFO=<ID=INS_SUBTYPE,Number=1,Type=String,Description="INS subtype: NOVEL or DUP (minimap2 refined)">
##INFO=<ID=INVDUP,Number=0,Type=Flag,Description="Inverted duplication: the extra copy is the reverse complement of the sequence it copies. On a CN_METHOD=UNIT CNV, some carrier gains copies walked opposite to the reference's (see FORMAT/CNINV); on an INS with INS_SUBTYPE=DUP, the inserted sequence aligns to the reference window on the reverse strand">
##INFO=<ID=REF_CN,Number=1,Type=Integer,Description="Reference copy number (CNV): copies of the repeat unit (CN_METHOD=UNIT) or of the module (MODULE)">
##INFO=<ID=UNIT_TWIN_NODES,Number=.,Type=String,Description="CN_METHOD=UNIT only: nodes refine's twin merge would fold into the loop node: the same sequence and the same oriented neighbours, a looped one only if its loop is walked. Their traversals are counted as copies of the unit in CN, REF_CN and CNINV">
##INFO=<ID=RU_LEN,Number=1,Type=Integer,Description="Repeat-unit length in bp, one represented copy. Emitted only for CN_METHOD=UNIT; (CN-REF_CN)*RU_LEN is the repeat-copy component of the haplotype size, while FORMAT/CNBP is the full module-walk change and CNRESID is their difference">
##INFO=<ID=CN_UNIT_BP,Number=1,Type=Integer,Description="CN_METHOD=MODULE only: one copy of the module, the reference's bp over its nodes divided by REF_CN. Copies of different types differ, so a carrier's own change is FORMAT:CNBP">
##INFO=<ID=CN_METHOD,Number=1,Type=String,Description="How CN was measured: UNIT (copies of a panphorte unit graph, counted exactly where they pass its anchor; a one-node unit graph's are its traversals) or MODULE (--cn: passes through the anchor of a collapsed module, the module nodes the most paths revisit)">
##INFO=<ID=CN_SCOPE,Number=1,Type=String,Description="What one copy is a copy of: REPEAT_UNIT (one traversal of a represented repeat unit; full per-haplotype module size is FORMAT/CNBP) or COLLAPSED_MODULE (a module that may hold several distinct paralogs; RU_LEN is not emitted, shared per-copy content is CN_UNIT_BP, and per-haplotype size is FORMAT/CNBP)">
##INFO=<ID=CN_SHARED_BP,Number=1,Type=Integer,Description="CN_METHOD=MODULE: the reference's bp over the module's nodes, each visit counted">
##INFO=<ID=CN_REF_FOLD,Number=1,Type=Integer,Description="CN_METHOD=MODULE: the reference's copies of the module (REF_CN); CN_UNIT_BP is CN_SHARED_BP/CN_REF_FOLD">
##INFO=<ID=CN_MODULE_REF_BP,Number=1,Type=Integer,Description="Reference bp across the whole bubble interior, the record's span. CN_SHARED_BP is the part on the module's nodes, the copies the record counts">
##INFO=<ID=REF_CN_SOURCE,Number=1,Type=String,Description="How REF_CN was counted: UNIT_ANCHOR (the unit graph's copies at its anchor) or ANCHOR_PASSES (MODULE: the reference's passes through the module's anchor, counted as every haplotype's are)">
##INFO=<ID=CN_ANCHOR_BP,Number=1,Type=Integer,Description="CN_METHOD=MODULE: bp of the module's anchor, the nodes CN counts passes through">
##INFO=<ID=CN_MODULE_NODES_BP,Number=1,Type=Integer,Description="CN_METHOD=MODULE: bp of the module's nodes, those some path visits more than once, one visit each">
##INFO=<ID=SUBSTITUTION,Number=0,Type=Flag,Description="The DEL or INS replaces the reference bases POS+1..END (DELSEQ) with INSSEQ, typed by its net change, which SVLEN gives. A replacement whose net change is under --min-sv-bp is a SVTYPE=SUB record with the two sequences as REF and ALT">
##INFO=<ID=HOMLEN,Number=1,Type=Integer,Description="Exact INS/DEL (not a substitution, not IMPRECISE): how many bases the event can slide right along the reference and stay the same haplotype. POS is left-aligned, so the equivalent placements are POS..POS+HOMLEN">
##INFO=<ID=CIPOS,Number=2,Type=Integer,Description="Interval around POS holding the equivalent placements of a left-aligned INS/DEL: 0,HOMLEN. On a PATH_INVERSION record: where the left breakpoint can lie, 0 to the length of the sequence between the left flank and the inverted run (typically an inverted repeat)">
##INFO=<ID=CIEND,Number=2,Type=Integer,Description="Interval around END holding the equivalent placements of a left-aligned DEL: 0,HOMLEN. On a PATH_INVERSION record: where the right breakpoint can lie, minus the length of the sequence between the inverted run and the right flank, to 0">
##INFO=<ID=PATH_INVERSION,Number=0,Type=Flag,Description="An inversion at an inversion site (bubble kind 'inversion'), typed from the haplotypes' walks: a run of reference nodes a haplotype walks reversed, between two runs it walks forward. Such a site is made where no snarl holds the inversion -- its breakpoints lie in inverted repeats the graph collapses, so every path crosses the repeat nodes in both orientations -- and encloses the sites inside it. POS is the last forward base before the inverted run, END the last base before the forward run after it; CIPOS/CIEND give the breakpoint ranges and IMPRECISE is set when they are not zero">
##INFO=<ID=IMPRECISE,Number=0,Type=Flag,Description="The record describes an event CLUSTER rather than one exact event: coalescing joined several pieces that have reference sequence retained between them, or the deletion spans loop copies a CNV record counts (their bases are left out of SVLEN), so the affected interval POS+1..END is wider than the |SVLEN| bases actually removed. On a PRECISE record END-POS equals |SVLEN| exactly; this flag marks the records where it cannot, instead of silently reporting one of the two numbers. Also set where a breakpoint abuts an N in the reference (the base before POS+1 or after END), which places the event only to within the N run">
##INFO=<ID=CN_SPAN_AMBIGUOUS,Number=1,Type=Integer,Description="Path measurements taken over a module span whose source or sink boundary occurs MORE THAN ONCE in that path. The span is then first-source..last-sink, which is a choice: it can enclose two separate visits and the content between them rather than one module. Every quantity measured over the span -- CN, CNBP, CN_MODULE_REF_BP -- inherits that choice on those paths. Absent when every boundary is visited once">
##INFO=<ID=MULTI_CROSSING,Number=1,Type=Integer,Description="Traversing paths that traverse this bubble more than once, counted over the whole path. A traversal is a run of consecutive steps from one boundary to the other with only bubble-interior nodes between (possibly none); a boundary touched from or towards outside the bubble is not one. The path's walk is one source..sink window, so it either spans the sequence between traversals, and the events and copy numbers taken from it count the interior once per traversal, or holds one traversal and leaves the others untyped. Reported, not corrected. Absent when every path traverses once">
##INFO=<ID=MULTI_CROSSING_UNSCORED,Number=1,Type=Integer,Description="Of the MULTI_CROSSING paths, those with a traversal the scored walk does not hold whose allele length differs from every reference traversal of this bubble by --min-sv-bp or more: an SV-sized difference no record here describes. Absent when none">
##INFO=<ID=NMERGED,Number=1,Type=Integer,Description="Haplotype carriers merged into this record">
##INFO=<ID=MERGE_DIAMETER,Number=1,Type=Float,Description="Weakest pairwise node Jaccard between any two events merged into this record. Node-comparison events merge by transitive single-linkage, so a record can span members that would never have merged directly (A-B-C with A and C dissimilar); MERGE_JACCARD reports the strongest edge and cannot show that, this reports the worst. Events from aligned alleles merge around a representative, each member matching it. Near 0 means the record's members share almost no nodes and the chain reached a long way. Absent on unmerged records">
##INFO=<ID=MERGE_DIAMETER_EXACT,Number=0,Type=Flag,Description="MERGE_DIAMETER, MERGE_JACCARD, MERGE_SEQID and MERGE_DIRECT_FRAC compared every pair of merged members. Absent means the component exceeded the all-pairs bound (128 members) and each was measured against the representative only">
##INFO=<ID=MERGE_JACCARD,Number=1,Type=Float,Description="Strongest node-set Jaccard over the pairs of merged members that match directly (every pair of the component, not only the pairs the merge sweep tested), and over force-called members against the representative">
##INFO=<ID=MERGE_SEQID,Number=1,Type=Float,Description="Strongest sequence identity over the same directly matching pairs, counted only where the Jaccard gate did not decide the pair">
##INFO=<ID=MERGE_DIRECT_FRAC,Number=1,Type=Float,Description="Share of member pairs of the merged component that match each other directly (same test as the merge). For node-comparison events (transitive single-linkage) below 1 means some members joined only through a chain; for events from aligned alleles (merged around a representative) it means members matched only through the representative. Force-called members are not counted. Absent on unmerged records">
##INFO=<ID=MERGE_SIZE_RATIO,Number=1,Type=Float,Description="Smallest/largest member size among merged members (min,max also in SVLEN_RANGE)">
##INFO=<ID=AN,Number=1,Type=Integer,Description="Allele number = haplotypes traversing the bubble">
##INFO=<ID=AC,Number=A,Type=Integer,Description="Allele count = carrier haplotypes">
##INFO=<ID=AF,Number=A,Type=Float,Description="Allele frequency = AC/AN (over traversing haplotypes)">
##INFO=<ID=INSSEQ,Number=1,Type=String,Description="Inserted sequence of the representative member (see SVLEN)">
##INFO=<ID=DELSEQ,Number=1,Type=String,Description="Deleted reference sequence of the representative member (see SVLEN)">
##INFO=<ID=INVSEQ,Number=1,Type=String,Description="Inverted reference sequence of the representative member (see SVLEN)">
##ALT=<ID=DEL,Description="Deletion">
##ALT=<ID=INS,Description="Insertion">
##ALT=<ID=INV,Description="Inversion">
##ALT=<ID=CNV,Description="Copy-number variable region: FORMAT/CN gives each haplotype's copy number and GT 1 marks a callable change from REF_CN, a gain or a loss (CN_METHOD=MODULE)">
##ALT=<ID=CNV:TR,Description="Tandem-repeat copy-number variation: copies of a repeat unit (RU_LEN), counted exactly per haplotype in FORMAT/CN (CN_METHOD=UNIT)">
##FORMAT=<ID=GT,Number=1,Type=String,Description="1=carrier, 0=reference-like, .=bubble not traversed">
##FORMAT=<ID=CN,Number=1,Type=Integer,Description="Copy number on a CNV record: copies of the repeat unit (CN_METHOD=UNIT) or of the module (MODULE); . on other records">
##FORMAT=<ID=CNBP,Number=1,Type=Integer,Description="Actual linear bp gained(+)/lost(-) by this haplotype vs the reference, from the spelled walk (node length x traversal multiplicity minus the reference's): over the bubble interior on CN_METHOD=UNIT; on MODULE, from the haplotype's first to its last module node, everything walked between. Recovers the linear SV size that a one-copy unit does not convey; CNV records only.">
##FORMAT=<ID=CNRESID,Number=1,Type=Integer,Description="CNBP - (CN-REF_CN) copies of RU_LEN (UNIT) or CN_UNIT_BP (MODULE): the bp this haplotype gained or lost that whole copies do NOT explain. 0 means the whole size difference is copy number; otherwise a partial copy or other sequence changed in the same site, and on MODULE also copies of another size than the reference's">
##FORMAT=<ID=CNINV,Number=1,Type=Integer,Description="CN_METHOD=UNIT only: how many of this haplotype's CN copies run opposite to the reference's copy of the unit. 0 means every copy is in the reference orientation; a gain with CNINV above the reference's is an inverted duplication (INFO/INVDUP)">
#CHROM	POS	ID	REF	ALT	QUAL	FILTER	INFO	FORMAT	ref#0#chr1:0-4600	h1#1#chr1	h2#1#chr1	hX#1#chr1	hZ#1#chr1
chr1	2000	bubble1_CNV_S	C	<CNV>	.	.	END=2600;SVTYPE=CNV;BUBBLE_ID=1;START_NODE=S;END_NODE=S;NMERGED=3;AN=5;AC=3;AF=0.6;EVENT_NODES=S;REF_CN=1;CN_UNIT_BP=300;CN_METHOD=MODULE;CN_SCOPE=COLLAPSED_MODULE;CN_SHARED_BP=600;CN_REF_FOLD=1;REF_CN_SOURCE=ANCHOR_PASSES;CN_ANCHOR_BP=600;CN_MODULE_NODES_BP=600;CN_MODULE_REF_BP=600	GT:CN:CNBP:CNRESID	0:1:0:0	0:1:0:0	1:2:600:0	1:2:600:0	1:2:600:0
chr1	2600	bubble1_INS_X	A	<INS>	.	.	END=2600;SVTYPE=INS;SVLEN=80;BUBBLE_ID=1;START_NODE=X;END_NODE=X;NMERGED=1;AN=5;AC=1;AF=0.2;EVENT_NODES=X;INSSEQ=CGATTCAAATGACGGCAGCAGGCCGGGAGTCCCTGAGAGGCTTGTTCCGGAAATGTGCCATCTGCGTGCGAACGCAGCGT	GT:CN	0:.	0:.	0:.	0:.	1:.
